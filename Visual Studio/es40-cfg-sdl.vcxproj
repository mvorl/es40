  <!-- The editor ships in every solution configuration, so its feature set is derived
       from the configuration name instead of duplicating 27 property groups. -->
  <PropertyGroup Label="ES40Configuration">
    <Es40IsDebug>false</Es40IsDebug>
    <Es40IsDebug Condition="$(Configuration.StartsWith('Debug'))">true</Es40IsDebug>
    <Es40Sse2>false</Es40Sse2>
    <Es40Sse2 Condition="$(Configuration.Contains('- SSE2'))">true</Es40Sse2>
    <Es40NoNetwork>false</Es40NoNetwork>
    <Es40NoNetwork Condition="$(Configuration.Contains(' NN'))">true</Es40NoNetwork>
    <Es40NoScreen>false</Es40NoScreen>
    <Es40NoScreen Condition="$(Configuration.Contains(' NS'))">true</Es40NoScreen>
    <Es40Jit>false</Es40Jit>
    <Es40Jit Condition="$(Configuration.Contains('JIT'))">true</Es40Jit>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Es40IsDebug)'=='true'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>NotSet</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Es40IsDebug)'!='true'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
